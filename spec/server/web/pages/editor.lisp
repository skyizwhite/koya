(deftest a-many-reference-is-chips-the-server-draws
  (exec "DELETE FROM contents")
  (multiple-value-bind (space model) (resolve-model "website" "blog")
    (let* ((chosen (content-id (create space model (jobject "title" "Chosen") :publish t)))
           (other (content-id (create space model (jobject "title" "Other") :publish t)))
           (id (content-id (create space model (jobject "title" "Refers" "related" (vector chosen)) :publish t)))
           (body (nth-value 1 (request :get (format nil "/s/website/m/blog/~a" id)))))
      (ok (search "nm-data=\"...koya.references(this)\"" body) "the field holds what is chosen")
      (ok (search "<select id=\"f-related\" name=\"f-related\" multiple hidden" body)
          "the select that is sent stays out of sight")
      (ok (search (format nil "<option value=\"~a\" selected nm-bind=\"{ selected: () => _has(this.value) }\"" chosen) body)
          "and follows the chips")
      (ok (search (format nil "data-id=\"~a\" nm-bind=\"{ hidden: () => !_has(this.dataset.id) }\"" chosen) body)
          "a chip for what is chosen")
      (ok (search (format nil "data-id=\"~a\" hidden nm-bind=\"{ hidden: () => !_has(this.dataset.id) }\"" other) body)
          "and one waiting for each of the rest")
      (ok (search (format nil "<option value=\"~a\" hidden disabled nm-bind=" chosen) body)
          "what is chosen is not offered again")
      (ok (search (format nil "<option value=\"~a\" nm-bind=\"{ hidden: () => _has(this.value), disabled: () => _has(this.value) }\"" other) body)
          "the rest are"))))

(deftest a-save-over-a-change-made-elsewhere-is-refused
  (exec "DELETE FROM contents")
  (let* ((model (nth-value 1 (resolve-model "website" "blog")))
         (id (content-id (create "website" model (jobject "title" "Opened" "slug" "opened")
                                 :updated-at "2024-01-01T00:00:00.000Z")))
         (path (format nil "/s/website/m/blog/~a" id)))
    (ok (search "name=\"updated-at\" value=\"2024-01-01T00:00:00.000Z\""
                (nth-value 1 (request :get path)))
        "the form carries when the content was last written, as it was opened")
    (update-draft "website" model id (jobject "title" "Changed elsewhere"))
    (dolist (op '("save" "publish"))
      (multiple-value-bind (status body)
          (edit path :form `(("action" . ,op) ("f-title" . "Typed here") ("f-slug" . "opened")
                             ("updated-at" . "2024-01-01T00:00:00.000Z")))
        (ok (= status 409) (format nil "~a is refused" op))
        (ok (search "changed elsewhere" body) "and says why")
        (ok (search (format nil "href=\"~a\"" path) body) "with a way to see the change")
        (ng (search "editor-form" body) "while the form, with what was typed, is left as it is")))
    (ok (string= (jget (content-draft (get-content "website" id)) "title") "Changed elsewhere")
        "and the change made elsewhere stays")
    (multiple-value-bind (status)
        (edit path :form `(("action" . "save") ("f-title" . "Typed here") ("f-slug" . "opened")
                           ("updated-at" . ,(content-updated-at (get-content "website" id)))))
      (ok (= status 200) "once the editor has seen it, it saves"))))

