(defun with-card ()
  (make-schema :custom-fields (list (make-custom-field "card" (list (make-field :heading :text :required t :max-length 5)
                                                                    (make-field :shown :boolean)
                                                                    (make-field :note :richtext :help "Shown under the heading")
                                                                    (make-field :link :reference :model "blog")
                                                                    (make-field :pinned :boolean :default t))))
               :models (list (blog-model)
                             (make-model "about" :object (list (make-field :body :richtext)))
                             (make-model "page" :list (list (make-field :title :text)
                                                            (make-field :card :custom :custom-field "card" :help "The card")))
                             (make-model "badge" :list (list (make-field :card :custom :custom-field "card" :required t))))))

(deftest a-custom-field-is-edited-as-its-fields
  (exec "DELETE FROM contents")
  (replace-schema "website" (with-card))
  (unwind-protect
       (progn
         (multiple-value-bind (status body) (request :get "/s/website/m/page/new")
           (ok (= status 200))
           (ok (cl-ppcre:scan "<div id=\"f-card-label\" class=\"label\">card<span[^>]*>custom</span><span[^>]*>The card</span></div>" body)
               "a heading like any field's, with its help beside it")
           (ok (search "<fieldset id=\"f-card\" aria-labelledby=\"f-card-label\"" body) "over a fieldset it names")
           (ok (search "The card" body) "with its help")
           (ok (search "id=\"f-card.heading\" name=\"f-card.heading\"" body) "and an input for each field inside")
           (ok (search "name=\"f-card.shown\"" body))
           (ok (search "data-quill-for=\"f-card.note\"" body) "rich text inside has its own editor")
           (ok (search "<select id=\"f-card.link\" name=\"f-card.link\"" body) "and a reference inside is picked under its path")
           (ok (search "name=\"f-card.pinned\" checked" body) "a boolean inside starts as its default says")
           (ok (search "Add card" body) "a custom field that is not required starts absent, to be added")
           (ok (search "<input type=\"hidden\" name=\"f-card\" value=\"on\" disabled" body)
               "so the form does not say it is there")
           (ok (cl-ppcre:scan "<fieldset id=\"f-card\"[^>]* hidden disabled" body) "and its fields are not sent")
           (ok (search "Shown under the heading" body)))
         (let ((body (nth-value 1 (request :get "/s/website/m/badge/new"))))
           (ok (cl-ppcre:scan "<fieldset id=\"f-card\" aria-labelledby=\"f-card-label\" class=\"[^\"]*\" nm-bind" body)
               "a required custom field starts there")
           (ng (search "Add card" body) "and cannot be added")
           (ng (search "Remove card" body) "or removed")
           (ok (search "<input type=\"hidden\" name=\"f-card\" value=\"on\" nm-ref" body) "so the form always says it is there"))
         (multiple-value-bind (status body)
             (edit "/s/website/m/page/new" :form '(("action" . "save") ("f-title" . "Absent") ("f-card.heading" . "Ignored")))
           (ok (= status 200) "without the form saying the custom field is there, what is inside is none")
           (let* ((loc (moved-to body)) (id (subseq loc (1+ (position #\/ loc :from-end t)))))
             (ok (null (nth-value 1 (gethash "card" (content-draft (get-content "website" id))))))))
         (multiple-value-bind (status body)
             (edit "/s/website/m/page/new" :form '(("action" . "save") ("f-title" . "P") ("f-card" . "on") ("f-card.heading" . "Too long")))
           (ok (= status 422))
           (ok (cl-ppcre:scan "<p id=\"f-card.heading-error\"[^>]*>must be at most 5 characters</p>" body)
               "an error inside is drawn under its field"))
         (multiple-value-bind (status body)
             (edit "/s/website/m/page/new" :form '(("action" . "save") ("f-title" . "P") ("f-card" . "on") ("f-card.heading" . "Hi") ("f-card.shown" . "on")
                                                   ("f-card.link" . "01ARZ3NDEKTSV4RRFFQ69G5FAV")))
           (ok (= status 200))
           (let* ((loc (moved-to body)) (id (subseq loc (1+ (position #\/ loc :from-end t)))))
             (let ((editor (nth-value 1 (request :get (format nil "/s/website/m/page/~a" id)))))
               (ok (search "value=\"Hi\"" editor) "and what was saved comes back in it")
               (ok (search "class=\"btn\" nm-bind=\"{ hidden: () => !_on, onclick: () => _remove() }\"" editor)
                   "open, with a button to remove it"))
             (ok (equal (jget (content-draft (get-content "website" id)) "card" "link") "01ARZ3NDEKTSV4RRFFQ69G5FAV")
                 "the reference picked inside is saved")
             (ok (search "Hi" (nth-value 1 (request :get "/s/website/m/page"))) "the list previews it")
             (edit (format nil "/s/website/m/page/~a" id) :form '(("action" . "save") ("f-title" . "P") ("f-card" . "on") ("f-card.heading" . "Bye")))
             (let ((history (nth-value 1 (request :get (format nil "/s/website/m/page/~a/history" id)))))
               (ok (search "heading: Bye" history) "the history shows the fields inside")
               (ng (search "HASH-TABLE" history))))))
    (replace-schema "website" (make-schema :models (list (blog-model)
                                                         (make-model "about" :object (list (make-field :body :richtext))))))))

(defun with-blocks ()
  (make-schema :custom-fields (list (make-custom-field "heading" (list (make-field :text :text :required t :max-length 5)))
                                    (make-custom-field "body" (list (make-field :text :richtext))))
