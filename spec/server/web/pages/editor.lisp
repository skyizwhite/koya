                   (make-schema :models (list (make-model "blog" :list (model-fields (blog-model)))
                                              (make-model "about" :object (list (make-field :body :richtext))))))
      (unwind-protect
           (let ((body (list-body)))
             (ok (search (format nil ">~a<" target) body)
