(deftest a-repeater-is-edited-row-by-row
  (exec "DELETE FROM contents")
  (replace-schema "website" (with-blocks))
  (unwind-protect
       (progn
         (multiple-value-bind (status body) (request :get "/s/website/m/doc/new")
           (ok (= status 200))
           (ok (cl-ppcre:scan "<div id=\"f-blocks-label\" class=\"label\">blocks<span[^>]*>repeater</span><span[^>]*>The page</span></div>" body)
               "a heading like any field's")
           (ok (search "<div id=\"f-blocks-rows\"" body) "over the rows")
           (ok (cl-ppcre:scan "<option value=\"heading\">heading</option><option value=\"body\">body</option>" body)
               "and a choice of the custom fields a row can be"))
         (multiple-value-bind (status body) (call-action :get (repeater-row :space "website" :model "doc" :field "blocks" :kind "body"))
           (ok (= status 200))
           (ok (search "<div id=\"f-blocks-rows\" nm-swap=\"append\">" body) "a row is added at the end of the rows")
           (ok (cl-ppcre:scan "name=\"f-blocks\" value=\"([a-z0-9]+)\"" body) "with a key of its own")
           (ok (cl-ppcre:scan "name=\"f-blocks\\.[a-z0-9]+\\.fieldId\" value=\"body\"" body) "naming its custom field")
           (ok (cl-ppcre:scan "data-quill-for=\"f-blocks\\.[a-z0-9]+\\.text\"" body) "and its fields under its key"))
         (ok (= 404 (call-action :get (repeater-row :space "website" :model "doc" :field "blocks" :kind "ghost")))
             "a custom field the repeater does not list makes no row")
         (multiple-value-bind (status body)
             (edit "/s/website/m/doc/new" :form '(("action" . "save") ("f-title" . "D") ("f-blocks" . "a,b")
                                                  ("f-blocks.a.fieldId" . "body") ("f-blocks.a.text" . "<p>Hi</p>")
                                                  ("f-blocks.b.fieldId" . "heading") ("f-blocks.b.text" . "Too long")))
           (ok (= status 422))
           (ok (cl-ppcre:scan "<p id=\"f-blocks.b.text-error\"[^>]*>must be at most 5 characters</p>" body)
               "an error in a row is drawn under its field"))
         (multiple-value-bind (status body)
             (edit "/s/website/m/doc/new" :form '(("action" . "save") ("f-title" . "D") ("f-blocks" . "a,b")
                                                  ("f-blocks.a.fieldId" . "body") ("f-blocks.a.text" . "<p>Hi</p>")
                                                  ("f-blocks.b.fieldId" . "heading") ("f-blocks.b.text" . "Head")))
           (ok (= status 200))
           (let* ((loc (moved-to body)) (id (subseq loc (1+ (position #\/ loc :from-end t)))))
             (let ((rows (jget (content-draft (get-content "website" id)) "blocks")))
               (ok (equal (map 'list (lambda (r) (jget r "fieldId")) rows) '("body" "heading")) "the rows are saved in order"))
             (let ((editor (nth-value 1 (request :get (format nil "/s/website/m/doc/~a" id)))))
               (ok (search "value=\"Head\"" editor) "and drawn again")
               (ok (search "aria-label=\"Move row up\"" editor) "each one movable")
               (ok (search "aria-label=\"Remove row\"" editor) "and removable"))
             (ok (search "2 rows" (nth-value 1 (request :get "/s/website/m/doc"))) "the list counts them")
             (edit (format nil "/s/website/m/doc/~a" id)
                   :form '(("action" . "save") ("f-title" . "D") ("f-blocks" . "b")
                           ("f-blocks.b.fieldId" . "heading") ("f-blocks.b.text" . "Bye")))
             (let ((history (nth-value 1 (request :get (format nil "/s/website/m/doc/~a/history" id)))))
               (ok (search "heading: text: Bye" history) "the history shows each row")
               (ng (search "HASH-TABLE" history))))))
    (replace-schema "website" (make-schema :models (list (blog-model)
                                                         (make-model "about" :object (list (make-field :body :richtext))))))))
