(deftest pages
  (multiple-value-bind (status body) (request :get "/s/website")
    (ok (= status 200))
    (ok (search "blog" body))
    (ok (search "about" body)))
  (multiple-value-bind (status body) (request :get "/s/website/m/blog")
    (ok (= status 200))
    (ok (search "New content" body)))
  (multiple-value-bind (status body) (request :get "/s/website/m/about")
    (ok (= status 200))
    (ok (search "id=\"editor\"" body) "object model is its editor"))
  (multiple-value-bind (status body) (request :get "/s/website/m/blog/new")
    (ok (= status 200))
    (ok (search "name=\"f-title\"" body))
    (ok (search "name=\"f-body\"" body))
    (ok (search "type=\"checkbox\"" body))
    (ok (search "datetime-local" body))
    (ok (search "data-quill-for=\"f-body\" nm-bind=\"{ oninit: () => koya.quill(this) }\"" body)
        "rich text gets a Quill holder")
    (ok (search (format nil "<form id=\"editor-form\" class=\"space-y-6\" nm-ref=\"form\" ~a"
                        (bound (on-submit (editor-action :space "website" :model "blog" :id "new" :op "save")
                                          :binds "oninput: () => _track(), onchange: () => _track()")))
                body)
        "the form is an action"))
  (multiple-value-bind (status) (request :get "/s/nope")
    (ok (= status 404)))
  (multiple-value-bind (status) (edit "/s/website/m/blog/new" :form '(("action" . "delete")))
    (ok (= status 404) "delete on /new has nothing to delete"))
  (multiple-value-bind (status) (edit "/s/website/m/blog/new" :form '(("action" . "unpublish")))
    (ok (= status 404)))
  (multiple-value-bind (status) (request :get "/s/website/m/nope")
    (ok (= status 404)))
  (multiple-value-bind (status) (request :get "/s/website/m/blog/01ARZ3NDEKTSV4RRFFQ69G5FAV")
    (ok (= status 404))))

(deftest every-page-runs-on-nomini
  (dolist (path '("/s/website" "/login"))
    (let ((*cookie* (if (string= path "/login") nil *cookie*)))
      (let ((body (nth-value 1 (request :get path))))
        (testing path
          (ok (search "/assets/js/nomini.js?" body))
          (ok (< (search "/assets/js/nomini.js?" body) (search "/assets/js/koya.js?" body))
              "then what the pages do with it")
          (ng (search "htmx" body))
          (ng (search "nm-data" (subseq body 0 (search "<body" body))) "the page itself is no scope")
          (ok (search "<body class=" body))
          (ok (search "<div id=\"location\" hidden></div>" body)
              "an answer that moves the browser is drawn here")
          (ng (search "onfetcherr" body) "a refusal is drawn as any answer is, with nothing on the element"))))))

(deftest every-page-offers-the-source
  (let ((version (asdf:component-version (asdf:find-system "koya-server"))))
    (flet ((footer-p (body)
             (and (search (format nil "koya ~a" version) body)
                  (search "href=\"https://github.com/skyizwhite/koya\"" body)
                  (search "GNU AGPL v3.0" body))))
      (ok (footer-p (nth-value 1 (request :get "/s/website"))) "a page behind the session")
      (let ((*cookie* nil))
        (ok (footer-p (nth-value 1 (request :get "/login"))) "the login page, before any session")))))

(deftest cache-control

  (multiple-value-bind (status body headers) (request :get "/assets/icon.svg")
    (declare (ignore body))
    (ok (= status 200))
    (ok (string= (getf headers :cache-control) "public, max-age=31536000, immutable") "assets are immutable"))
  (multiple-value-bind (status body headers) (request :get "/assets/nope.css")
    (declare (ignore body))
    (ok (= status 404))
    (ok (string= (getf headers :cache-control) "no-store") "a missing asset is not cached"))
  (ok (= 400 (request :get "/assets/../koya-server.asd")) "nothing outside assets/ is served")
  (let ((*cookie* nil))
    (multiple-value-bind (status body headers) (request :get "/login")
      (ok (= status 200))
      (ok (string= (getf headers :cache-control) "no-store") "pages are not cached")
      (ok (search "/assets/style/dist.css?v=" body) "asset URLs carry a version")
      (ok (search "/assets/icon.svg?v=" body)))))

(deftest assets-skip-the-session
  (let* ((fetches 0)
         (spy (defmethod lack/middleware/session/store:fetch-session :around (store sid)
                (declare (ignore store sid))
                (incf fetches)
                (call-next-method))))
    (unwind-protect
         (progn
           (ok (= (request :get "/assets/icon.svg") 200))
           (ok (= fetches 0) "an asset does not read the owner's session")
           (request :get "/s/website")
           (ok (= fetches 1) "a page does")
           (ok (= 404 (request :get "/assets")))
           (ok (= 404 (request :get "/assets/")))
           (ok (= 1 fetches) "nor does the assets' prefix"))
      (remove-method #'lack/middleware/session/store:fetch-session spy))))

(defun fail-with (secret)
  (error "The probe fails after ~a characters" (length secret)))

(deftest an-error-is-logged-and-not-cached
  (setf (route *page-app* "/probe-page-that-fails")
        (lambda (params) (declare (ignore params)) (fail-with "probe-argument-secret")))
  (let* ((status nil)
         (body nil)
         (headers nil)
         (errors (make-string-output-stream))
         (out (make-string-output-stream))
         (log (logged (lambda ()
                        (let ((*standard-output* out) (*error-output* errors))
                          (multiple-value-setq (status body headers)
                            (request :get "/probe-page-that-fails" :query "draft-key=query-secret")))))))
    (ok (= status 500))
    (ok (search "Internal Server Error" body))
    (ok (search "[ERROR] <KOYA.HTTP>: GET /probe-page-that-fails: The probe fails after 21 characters" log)
        "the error is logged with its method and path")
    (ok (search "KOYA-SPEC/SERVER/WEB/APP::FAIL-WITH" log) "and the backtrace")
    (ok (every (lambda (line) (or (zerop (length line)) (char= (char line 0) #\Space) (cl-ppcre:scan "^\\d{4}-" line)))
               (uiop:split-string log :separator '(#\Newline)))
        "one frame to a line, under the line it belongs to")
    (ng (search "probe-argument-secret" log) "which names each function without its arguments")
    (ng (search "query-secret" log) "nor is the query logged")
    (ok (= 1 (count-matches "<KOYA.HTTP>" log)) "it is logged once, by koya")
    (ok (string= (get-output-stream-string errors) "") "and nothing else")
    (ok (string= (getf headers :cache-control) "no-store") "an error page is not cached")
    (ok (search "[INFO ] <KOYA.ACCESS>: 127.0.0.1 - [" log) "the access log is a line of the log")
    (ok (search "\"GET /probe-page-that-fails HTTP/1.1\" 500" log) "and holds the error")
    (ok (string= (get-output-stream-string out) "") "written by the log alone, so no two lines run into each other")))

(deftest a-handled-error-is-no-error-in-the-log
  (let ((status nil))
    (let ((log (logged (lambda ()
                         (setf status (call-action :post (create-space-action) :form '(("name" . "Not A Slug"))))))))
      (ok (= status 422) "the action signals the error and answers it itself")
      (ok (search "<KOYA.ACCESS>" log))
      (ng (search "<KOYA.HTTP>" log) "so it is no unhandled error"))))

(deftest the-access-log-leaves-out-every-query
  (let ((access (logged (lambda ()
                          (request :get "/s/website" :query "draft-key=query-secret"
                                                     :headers '(("referer" . "https://site.test/blog/a?draft-key=referer-secret")))))))
    (ok (search "\"GET /s/website HTTP/1.1\" 200" access))
    (ok (search "\"https://site.test/blog/a\"" access) "the referer is kept up to its query")
    (ng (search "secret" access))))

(deftest an-api-error-is-logged-as-a-page-error-is
  (setf (route *api-app* "/v1/website/probe-fails")
        (lambda (params) (declare (ignore params)) (fail-with "probe-argument-secret")))
  (let* ((status nil)
         (body nil)
         (log (logged (lambda ()
                        (multiple-value-setq (status body)
                          (request :get "/api/v1/website/probe-fails"
                                   :headers `(("x-koya-delivery-key" . ,(create-delivery-key "website")))))))))
    (ok (= status 500))
    (ok (search "internal_error" body) "the answer is the API's own")
    (ok (search "[ERROR] <KOYA.HTTP>: GET /api/v1/website/probe-fails: The probe fails after 21 characters" log))
    (ok (search "KOYA-SPEC/SERVER/WEB/APP::FAIL-WITH" log))
    (ng (search "probe-argument-secret" log))))

(deftest a-trailing-slash
  (multiple-value-bind (status body headers) (request :get "/s/website/")
    (declare (ignore body))
    (ok (= status 301) "a page is sent to its URL")
    (ok (string= (location headers) "/s/website")))
  (let* ((url (media-picker :space "website"))
         (q (position #\? url))
         (slashed (format nil "~a/~a" (subseq url 0 q) (subseq url q))))
    (multiple-value-bind (status body headers) (call-action :get slashed)
      (declare (ignore body))
      (ok (= status 301) "so is an action")
      (ok (string= (location headers) url) "with its query"))
    (let ((*cookie* nil))
      (ok (= (call-action :get slashed) 401) "but not without the owner session"))
    (ok (= (request-url :get slashed) 400) "nor from outside the admin UI")
    (ok (= (call-action :post slashed) 404) "nor when it is not a GET"))
  (multiple-value-bind (status body headers)
      (request :get "/api/v1/website/lists/blog/" :headers `(("x-koya-delivery-key" . ,(create-delivery-key "website"))))
    (declare (ignore body))
    (ok (= status 301) "so is the delivery API")
    (ok (string= (location headers) "/api/v1/website/lists/blog"))
    (ok (string= (getf headers :access-control-allow-origin) "*")
        "with CORS headers, so a page on another origin can follow it")))

(deftest body-size-limit
  (flet ((huge-post (headers &key (path "/login") (mb 3000) (content-type "multipart/form-data; boundary=x"))
           (funcall (app) (list :request-method :post :script-name "" :path-info path :query-string ""
                                :server-name "localhost" :server-port 3000 :server-protocol :http/1.1
                                :request-uri path :url-scheme "http" :remote-addr "127.0.0.1"
                                :headers (alist-hash-table (acons "host" "localhost:3000" headers) :test 'equal)
                                :content-type content-type :content-length (* mb 1024 1024)
                                :raw-body (make-in-memory-input-stream (string-to-octets ""))))))
    (destructuring-bind (status headers body) (huge-post nil)
      (declare (ignore headers))
      (ok (= status 413) "a huge Content-Length is refused before the body is read")
      (ok (search "too_large" (first body))))
    (destructuring-bind (status headers body) (huge-post '(("nm-request" . "true")))
      (ok (= status 413))
      (ok (search "text/html" (getf headers :content-type)) "the page shows it, so it is HTML")
      (ok (search "limited to" (first body)))
      (ok (not (search "too_large" (first body)))))
    (ok (= smart-buffer:*default-disk-limit* +max-body-bytes+)
        "Woo holds no more of a body than the app would take")))
