(defpackage #:koya-spec/server/usecases/revisions
  (:use #:cl #:rove)
  (:import-from #:koya-server/infra/db/connection #:connect-db #:disconnect-db #:exec)
  (:import-from #:koya-server/infra/db/migrations #:migrate)
  (:import-from #:koya-server/usecases/schema #:replace-schema #:find-model)
  (:import-from #:koya-server/usecases/spaces #:create-space)
  (:import-from #:koya-server/usecases/contents #:create)
  (:import-from #:koya-server/usecases/revisions #:restore-data)
  (:import-from #:koya-server/usecases/ports/media #:insert-media)
  (:import-from #:koya-server/domain/media #:media-id)
  (:import-from #:koya-server/domain/content #:content-id)
  (:import-from #:koya-core/schema #:make-field #:make-model #:make-schema #:make-custom-field)
  (:import-from #:koya-core/case #:kebab-keyword)
  (:import-from #:access #:access)
  (:import-from #:koya-core/data #:data-equal)
  (:import-from #:koya-server/domain/id #:new-id)
  (:import-from #:koya-spec/server/reads #:reads-of))
(in-package #:koya-spec/server/usecases/revisions)

(defun schema (&rest post-fields)
  (make-schema :models (list (make-model "post" :list post-fields)
                             (make-model "tag" :list (list (make-field :name :text))))))

(setup
  (connect-db ":memory:")
  (migrate)
  (create-space "site"))

(teardown (disconnect-db))

(defhook :before
  (exec "DELETE FROM contents")
  (exec "DELETE FROM media")
  (replace-schema "site" (schema (make-field :title :text :required t)
                                 (make-field :lede :text)
                                 (make-field :count :number :max 10)
                                 (make-field :slug :slug)
                                 (make-field :cover :media)
                                 (make-field :tags :reference :model "tag" :many t))))

(defun object (&rest pairs)
  (loop :for (k v) :on pairs :by #'cddr :append (list (kebab-keyword k) v)))
(defun post () (find-model "site" "post"))
(defun notes-of (notes) (mapcar (lambda (n) (getf n :field)) notes))

(deftest a-version-comes-back-as-it-was
  (multiple-value-bind (data notes)
      (restore-data "site" (post) "x" (object "title" "Old" "lede" "Then" "count" 3) (object "title" "Now"))
    (ok (null notes))
    (ok (string= (access data :title) "Old"))
    (ok (string= (access data :lede) "Then"))
    (ok (= (access data :count) 3))))

(deftest what-the-schema-no-longer-has
  (testing "a value the field no longer accepts keeps the current one"
    (replace-schema "site" (schema (make-field :title :text :required t) (make-field :count :number :max 10)))
    (multiple-value-bind (data notes) (restore-data "site" (post) "x" (object "title" "Old" "count" 99) (object "count" 5))
      (ok (= (access data :count) 5))
      (ok (equal (notes-of notes) '("count")))
      (ok (search "no longer accepts" (getf (first notes) :note)))))
  (testing "a field that is required now, and was empty then, keeps the current value"
    (replace-schema "site" (schema (make-field :title :text :required t) (make-field :lede :text :required t)))
    (multiple-value-bind (data notes) (restore-data "site" (post) "x" (object "title" "Old") (object "lede" "Kept"))
      (ok (string= (access data :lede) "Kept"))
      (ok (equal (notes-of notes) '("lede"))))))

(deftest what-the-space-no-longer-has
  (let ((live (create "site" (find-model "site" "tag") (object "name" "live") :publish t))
        (drafted (create "site" (find-model "site" "tag") (object "name" "draft")))
        (media (insert-media "site" (new-id) :filename "c.png" :mime "image/png" :size 1)))
    (testing "references to what is gone or unpublished are dropped, the rest kept"
      (multiple-value-bind (data notes)
          (restore-data "site" (post) "x"
                        (object "title" "Old" "tags" (vector (content-id live) (content-id drafted) "gone"))
                        (object))
        (ok (data-equal (access data :tags) (vector (content-id live))))
        (ok (equal (notes-of notes) '("tags")))
        (ok (search "2 references" (getf (first notes) :note)))))
    (testing "a media that is still in the library comes back; one that is not is dropped"
      (ok (string= (access (restore-data "site" (post) "x" (object "title" "Old" "cover" (media-id media)) (object)) :cover)
                   (media-id media)))
      (multiple-value-bind (data notes) (restore-data "site" (post) "x" (object "title" "Old" "cover" "01GONE") (object))
        (ng (nth-value 1 (access data :cover)))
        (ok (equal (notes-of notes) '("cover")))))))

(deftest a-version-s-references-and-media-are-read-together
  (replace-schema "site" (make-schema :custom-fields (list (make-custom-field "card" (list (make-field :link :reference :model "tag")
                                                                                          (make-field :photo :media))))
                                      :models (list (make-model "post" :list (list (make-field :title :text)
                                                                                   (make-field :cover :media)
                                                                                   (make-field :lead :reference :model "tag")
                                                                                   (make-field :tags :reference :model "tag" :many t)
                                                                                   (make-field :cards :repeater :custom-fields '(card))))
                                                    (make-model "tag" :list (list (make-field :name :text))))))
  (let* ((tags (loop :for name :in '("a" "b" "c")
                     :collect (content-id (create "site" (find-model "site" "tag") (object "name" name) :publish t))))
         (media (loop :for name :in '("a.png" "b.png" "c.png")
                      :collect (media-id (insert-media "site" (new-id) :filename name :mime "image/png" :size 1))))
         (one (reads-of (lambda ()
                          (restore-data "site" (post) "x"
                                        (object "title" "Old" "cover" (first media) "tags" (vector (first tags))
                                                "cards" (vector (object "fieldId" "card" "link" (first tags) "photo" (first media))))
                                        (object)))))
         (rows (loop :for tag :in tags :for photo :in media
                     :collect (object "fieldId" "card" "link" tag "photo" photo))))
    (ok (equal one '("(FIND-CONTENTS-BY-IDS tag)" "FIND-MEDIA-BY-IDS"))
        "a version is read once for the contents of each model it refers to and once for its media")
    (ok (equal (reads-of (lambda ()
                           (restore-data "site" (post) "x"
                                         (object "title" "Old" "cover" (second media) "lead" (second tags)
                                                 "tags" (coerce (append tags '("gone")) 'vector)
                                                 "cards" (coerce rows 'vector))
                                         (object))))
               one)
        "however many references and media its fields and rows hold")))

(deftest a-unique-value-another-content-took-since
  (let ((other (create "site" (post) (object "title" "Taken" "slug" "taken") :publish t))
        (mine (create "site" (post) (object "title" "Mine" "slug" "mine") :publish t)))
    (multiple-value-bind (data notes)
        (restore-data "site" (post) (content-id mine) (object "title" "Mine" "slug" "taken") (object "slug" "mine"))
      (ok (string= (access data :slug) "mine") "the version's slug is the other content's now")
      (ok (equal (notes-of notes) '("slug"))))
    (ok (string= (access (restore-data "site" (post) (content-id other) (object "title" "Taken" "slug" "taken") (object)) :slug)
                 "taken")
        "a content's own value is not taken from it")))

(deftest what-a-custom-field-no-longer-has
  (replace-schema "site" (make-schema :custom-fields (list (make-custom-field "card" (list (make-field :link :reference :model "tag")
                                                                                          (make-field :photo :media)
                                                                                          (make-field :caption :text))))
                                      :models (list (make-model "post" :list (list (make-field :title :text)
                                                                                   (make-field :card :custom :custom-field "card")))
                                                    (make-model "tag" :list (list (make-field :name :text))))))
  (multiple-value-bind (data notes)
      (restore-data "site" (post) "x" (object "title" "Old" "card" (object "link" "gone" "photo" "01GONE" "caption" "Kept"))
                    (object))
    (let ((card (access data :card)))
      (ng (nth-value 1 (access card :link)) "a reference inside to what is gone is dropped")
      (ng (nth-value 1 (access card :photo)) "and a media")
      (ok (string= (access card :caption) "Kept") "the rest of the custom field comes back"))
    (ok (equal (notes-of notes) '("card")) "and the note names the custom field")
    (ok (equal (getf (first notes) :note)
               "link lost 1 reference to content that was deleted or is not published; photo lost 1 media that is no longer in the library")
        "and each field inside that lost something, in the custom field's order"))
  (let* ((live (content-id (create "site" (find-model "site" "tag") (object "name" "live") :publish t)))
         (media (media-id (insert-media "site" (new-id) :filename "c.png" :mime "image/png" :size 1)))
         (card (access (restore-data "site" (post) "x" (object "title" "Old" "card" (object "link" live "photo" media)) (object))
                       :card)))
    (ok (and (string= (access card :link) live) (string= (access card :photo) media))
        "a reference and a media inside that are still there come back")))

(deftest what-a-row-no-longer-has
  (replace-schema "site" (make-schema :custom-fields (list (make-custom-field "card" (list (make-field :link :reference :model "tag")
                                                                                          (make-field :photo :media)
                                                                                          (make-field :caption :text))))
                                      :models (list (make-model "post" :list (list (make-field :title :text)
                                                                                   (make-field :cards :repeater :custom-fields '(card))))
                                                    (make-model "tag" :list (list (make-field :name :text))))))
  (multiple-value-bind (data notes)
      (restore-data "site" (post) "x" (object "title" "Old" "cards" (vector (object "fieldId" "card" "link" "gone" "caption" "Kept")
                                                                     (object "fieldId" "card" "photo" "01GONE")))
                    (object))
    (let ((row (aref (access data :cards) 0)))
      (ng (nth-value 1 (access row :link)) "a reference in a row to what is gone is dropped")
      (ok (string= (access row :caption) "Kept") "the rest of the row comes back"))
    (ok (equal (notes-of notes) '("cards")) "and the note names the repeater")
    (ok (equal (getf (first notes) :note)
               "link lost 1 reference to content that was deleted or is not published; photo lost 1 media that is no longer in the library")
        "and each field in a row that lost something, in row order"))
  (let* ((live (content-id (create "site" (find-model "site" "tag") (object "name" "live") :publish t)))
         (media (media-id (insert-media "site" (new-id) :filename "c.png" :mime "image/png" :size 1)))
         (row (aref (access (restore-data "site" (post) "x"
                                          (object "title" "Old" "cards" (vector (object "fieldId" "card" "link" live "photo" media)))
                                          (object))
                            :cards)
                    0)))
    (ok (and (string= (access row :link) live) (string= (access row :photo) media))
        "a reference and a media in a row that are still there come back")))
