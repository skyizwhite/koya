(defpackage #:koya-spec/server/usecases/delivery
  (:use #:cl #:rove)
  (:import-from #:koya-server/infra/db/connection #:connect-db #:disconnect-db #:exec)
  (:import-from #:koya-server/infra/db/migrations #:migrate)
  (:import-from #:koya-server/usecases/schema #:replace-schema #:find-model)
  (:import-from #:koya-spec/server/schema #:with-schema)
  (:import-from #:koya-server/usecases/spaces #:create-space)
  (:import-from #:koya-server/usecases/contents #:create #:update-draft #:draft-key)
  (:import-from #:koya-server/usecases/delivery
                #:deliver #:delivered-data #:delivered-p #:delivered-content
                #:delivered-list-content #:delivered-list #:delivered-object
                #:delivered-list-content-by-slug)
  (:import-from #:koya-server/usecases/ports/media #:insert-media)
  (:import-from #:koya-spec/server/reads #:reads-of)
  (:import-from #:koya-server/domain/media #:media-p #:media-id)
  (:import-from #:koya-server/domain/content #:content-id)
  (:import-from #:koya-server/domain/errors #:not-found)
  (:import-from #:koya-server/domain/query #:parse-query #:query-error)
  (:import-from #:koya-core/schema #:make-field #:make-model #:make-schema #:make-custom-field)
  (:import-from #:koya-core/case #:kebab-keyword)
  (:import-from #:access #:access)
  (:import-from #:koya-core/data #:data-equal))
(in-package #:koya-spec/server/usecases/delivery)

(setup
  (connect-db ":memory:")
  (migrate)
  (create-space "site")
  (replace-schema "site"
                  (make-schema :models (list (make-model "post" :list (list (make-field :title :text :required t)
                                                                           (make-field :cover :media)
                                                                           (make-field :author :reference :model "author")
                                                                           (make-field :tags :reference :model "tag" :many t)
                                                                           (make-field :body :richtext)))
                                             (make-model "author" :list (list (make-field :name :text)
                                                                             (make-field :avatar :media)
                                                                             (make-field :favorite :reference :model "tag")))
                                             (make-model "tag" :list (list (make-field :name :text)))
                                             (make-model "page" :list (list (make-field :title :text)
                                                                           (make-field :slug :slug)))
                                             (make-model "about" :object (list (make-field "body" :text)))))))

(teardown (disconnect-db))

(defhook :before (exec "DELETE FROM contents") (exec "DELETE FROM media"))

(defun model (name) (find-model "site" name))
(defun make (model-name data &rest args)
  (apply #'create "site" (model model-name) (data-from data) args))
(defun data-from (pairs)
  (loop :for (k v) :on pairs :by #'cddr :append (list (kebab-keyword k) v)))
(defun query (&rest kv) (parse-query (loop :for (k v) :on kv :by #'cddr :collect (cons k v))))
(defun picture (id)
  (media-id (insert-media "site" id :filename "p.png" :mime "image/png" :size 1 :width 1 :height 1)))

(deftest media-fields-hold-their-media
  (let* ((cover (picture "01ARZ3NDEKTSV4RRFFQ69G5FAA"))
         (post (make "post" (list "title" "One" "cover" cover) :publish t))
         (data (delivered-data (deliver post (model "post") "site"))))
    (ok (media-p (access data :cover)) "the id became the media, without being asked")
    (ok (string= (media-id (access data :cover)) cover))
    (testing "a media that has since gone is null, not a dangling id"
      (exec "DELETE FROM media")
      (ok (eq :null (access (delivered-data (deliver post (model "post") "site")) :cover))))
    (testing "the content itself is untouched"
      (ok (stringp (access (koya-server/domain/content:content-published post) :cover))))))

(deftest references-stay-ids-unless-included
  (let* ((author (make "author" (list "name" "Ann") :publish t))
         (tag (make "tag" (list "name" "lisp") :publish t))
         (draft-tag (make "tag" (list "name" "unseen")))
         (post (make "post" (list "title" "One" "author" (content-id author)
                                  "tags" (vector (content-id tag) (content-id draft-tag) "gone"))
                     :publish t)))
    (let ((plain (delivered-data (deliver post (model "post") "site"))))
      (ok (string= (access plain :author) (content-id author)) "an id, as stored")
      (ok (= (length (access plain :tags)) 3)))
    (let ((data (delivered-data (deliver post (model "post") "site" :include '(("author") ("tags"))))))
      (ok (delivered-p (access data :author)) "included: the content, delivered in turn")
      (ok (string= (access (delivered-data (access data :author)) :name) "Ann"))
      (ok (= (length (access data :tags)) 1) "of three tags only the published one that exists is delivered")
      (ok (string= (access (delivered-data (aref (access data :tags) 0)) :name) "lisp")))
    (testing "what is included carries its media, and a path names its references"
      (let* ((avatar (picture "01ARZ3NDEKTSV4RRFFQ69G5FAB"))
             (pictured (make "author" (list "name" "Bo" "avatar" avatar "favorite" (content-id tag)) :publish t))
             (post (make "post" (list "title" "Two" "author" (content-id pictured)) :publish t))
             (shallow (delivered-data (access (delivered-data (deliver post (model "post") "site" :include '(("author")))) :author)))
             (deep (delivered-data (access (delivered-data (deliver post (model "post") "site" :include '(("author" "favorite")))) :author))))
        (ok (media-p (access shallow :avatar)) "media, always")
        (ok (stringp (access shallow :favorite)) "a reference, only when its path is asked for")
        (ok (delivered-p (access deep :favorite)))
        (ok (string= (access (delivered-data (access deep :favorite)) :name) "lisp"))))
    (testing "an include that names no reference field is a bad query"
      (ok (signals (delivered-list "site" (model "post") (query "include" "title")) 'query-error)))))

(deftest an-include-is-checked-before-anything-is-read
  (flet ((refused (thunk)
           (handler-case (progn (funcall thunk) nil)
             (query-error (e) (princ-to-string e)))))
    (testing "on a list with nothing in it"
      (ok (refused (lambda () (delivered-list "site" (model "post") (query "include" "title"))))
          "a field that is no reference")
      (ok (refused (lambda () (delivered-list "site" (model "post") (query "include" "bogus"))))
          "a field the model does not have"))
    (testing "a path is checked to its end, whatever the references hold"
      (make "post" (list "title" "No tags" "tags" (vector)) :publish t)
      (let ((message (refused (lambda () (delivered-list "site" (model "post") (query "include" "tags.name"))))))
        (ok message "a segment that is no reference of the model it reaches")
        (ok (search "tags.name" message) "named by its path"))
      (ok (refused (lambda () (delivered-list "site" (model "post") (query "include" "author.favorite.name")))))
      (ok (null (refused (lambda () (delivered-list "site" (model "post") (query "include" "author.favorite,tags")))))
          "a path that only names references is fine"))
    (testing "before one content is looked for"
      (ok (refused (lambda () (delivered-list-content "site" (model "post") "nothing-here" (query "include" "title"))))
          "a bad query, not a missing content")
      (ok (refused (lambda () (delivered-object "site" (model "about") (query "include" "body"))))))))

(deftest searching
  (let ((lisp (make "post" (list "title" "Lisp macros" "body" "<p>Write <strong>macros</strong> in Lisp</p>") :publish t))
        (other (make "post" (list "title" "Other" "body" "<p>AT&amp;T and 100%</p>") :publish t)))
    (make "post" (list "title" "Draft lisp"))
    (flet ((found (&rest kv)
             (sort (mapcar (lambda (d) (content-id (delivered-content d))) (delivered-list "site" (model "post") (apply #'query kv)))
                   #'string<))
           (ids (&rest contents) (sort (mapcar #'content-id contents) #'string<)))
      (testing "q searches the text fields of what is published"
        (ok (equal (found "q" "lisp") (ids lisp)) "the title, either case, and not the draft")
        (ok (equal (found "q" "macros in") (ids lisp)) "rich text is searched as the text it reads")
        (ok (equal (found "q" "AT&T") (ids other)) "with its character references read")
        (ok (null (found "q" "strong")) "and not its tags")
        (ok (equal (found "q" "100%") (ids other)))
        (ok (null (found "q" "_")) "a LIKE wildcard is only itself")
        (ok (equal (found "q" (content-id other)) (ids other)) "the id, whole")
        (ok (equal (found "q" "") (ids lisp other)) "an empty q is no search"))
      (testing "q and filters both apply"
        (ok (null (found "q" "lisp" "filters" "title[equals]Other")))
        (ok (equal (found "q" "and" "filters" "title[equals]Other") (ids other))))
      (testing "a filter on rich text reads its text as well"
        (ok (null (found "filters" "body[contains]strong")))
        (ok (equal (found "filters" "body[contains]macros in") (ids lisp)))
        (ok (equal (found "filters" "body[begins_with]Write") (ids lisp)))
        (ok (equal (found "filters" "body[not_contains]strong") (ids lisp other)))))))

(deftest what-is-delivered-and-what-is-not
  (let* ((live (make "post" (list "title" "Live") :publish t))
         (draft (make "post" (list "title" "Draft")))
         (id (content-id draft)))
    (ok (string= (access (delivered-data (delivered-list-content "site" (model "post") (content-id live) (query))) :title) "Live"))
    (ok (signals (delivered-list-content "site" (model "post") id (query)) 'not-found) "a draft is not there")
    (ok (signals (delivered-list-content "site" (model "post") "nope" (query)) 'not-found))
    (testing "but its draft key opens it, as a preview"
      (let ((key (draft-key "site" (model "post") id)))
        (ok (string= (access (delivered-data (delivered-list-content "site" (model "post") id (query) :draft-key key)) :title) "Draft"))
        (ok (signals (delivered-list-content "site" (model "post") id (query) :draft-key "wrong") 'not-found))
        (testing "and shows the draft of a published content, where the key is the new draft's"
          (update-draft "site" (model "post") (content-id live) (data-from (list "title" "Live, edited")))
          (let ((key (draft-key "site" (model "post") (content-id live))))
            (ok (string= (access (delivered-data (delivered-list-content "site" (model "post") (content-id live) (query) :draft-key key)) :title)
                         "Live, edited"))
            (ok (string= (access (delivered-data (delivered-list-content "site" (model "post") (content-id live) (query))) :title)
                         "Live") "without it, what is live")))
        (testing "and embeds only what is published, as publishing this one alone would show it"
          (let* ((tag (make "tag" (list "name" "lisp") :publish t))
                 (new-tag (make "tag" (list "name" "new")))
                 (author (make "author" (list "name" "Ann") :publish t))
                 (preview (make "post" (list "title" "Preview" "author" (content-id author)
                                             "tags" (vector (content-id tag) (content-id new-tag))))))
            (update-draft "site" (model "tag") (content-id tag) (data-from (list "name" "lisp, edited")))
            (update-draft "site" (model "author") (content-id author) (data-from (list "name" "Ann, edited")))
            (let* ((key (draft-key "site" (model "post") (content-id preview)))
                   (data (delivered-data (delivered-list-content "site" (model "post") (content-id preview)
                                                        (query "include" "author,tags") :draft-key key)))
                   (tags (access data :tags)))
              (ok (= (length tags) 1) "a tag never published drops out")
              (ok (string= (access (delivered-data (aref tags 0)) :name) "lisp") "a published tag shows what is live, not its draft")
              (ok (string= (access (delivered-data (access data :author)) :name) "Ann")))))))
    (testing "a list is the published ones, with how many there are"
      (multiple-value-bind (items total) (delivered-list "site" (model "post") (query "limit" "1"))
        (ok (= total 1))
        (ok (= (length items) 1))
        (ok (string= (content-id (delivered-content (first items))) (content-id live)))))
    (testing "an object model delivers its one content"
      (ok (signals (delivered-object "site" (model "about") (query)) 'not-found) "none yet")
      (make "about" (list "body" "hi") :publish t)
      (ok (string= (access (delivered-data (delivered-object "site" (model "about") (query))) :body) "hi")))))

(defun with-byline ()
  (make-schema :custom-fields (list (make-custom-field "byline" (list (make-field :note :richtext)
                                                                      (make-field :caption :text)
                                                                      (make-field :kind :select :options '("zebra" "other"))
                                                                      (make-field :photo :media)
                                                                      (make-field :by :reference :model "author"))))
               :models (list (make-model "story" :list (list (make-field :title :text)
                                                             (make-field :byline :custom :custom-field "byline")))
                             (make-model "author" :list (list (make-field :name :text)
                                                              (make-field :favorite :reference :model "tag")))
                             (make-model "tag" :list (list (make-field :name :text))))))

(deftest a-content-is-delivered-by-its-slug
  (flet ((title (slug &key draft-key)
           (access (delivered-data (delivered-list-content-by-slug "site" (model "page") slug (query) :draft-key draft-key)) :title)))
    (let ((live (content-id (make "page" (list "title" "Live" "slug" "live") :publish t)))
          (drafted (content-id (make "page" (list "title" "Drafted" "slug" "drafted")))))
      (update-draft "site" (model "page") live (data-from (list "title" "Live, next" "slug" "live-next")))
      (ok (string= (title "live") "Live") "by its published slug, as published")
      (ok (signals (title "live-next") 'not-found) "not by its draft's")
      (ok (signals (title "drafted") 'not-found) "nor a content that is only a draft")
      (ok (signals (title "nope") 'not-found))
      (testing "with its draft key"
        (let ((key (draft-key "site" (model "page") live)))
          (ok (string= (title "live-next" :draft-key key) "Live, next") "by its draft's slug, as the draft")
          (ok (string= (title "live" :draft-key key) "Live, next") "and by its published slug, as the draft too"))
        (ok (string= (title "drafted" :draft-key (draft-key "site" (model "page") drafted)) "Drafted")
            "a content that is only a draft"))
      (testing "with a key that is not the content's"
        (ok (signals (title "live-next" :draft-key "wrong") 'not-found)
            "its draft's slug finds nothing, so the slug is not given away")
        (ok (signals (title "live-next" :draft-key (draft-key "site" (model "page") drafted)) 'not-found)
            "nor does another content's key")
        (ok (string= (title "live" :draft-key "wrong") "Live") "its published slug finds it, as published")))))

(deftest a-custom-field-is-delivered-like-the-fields-it-holds
  (with-schema ("site" (with-byline))
    (let* ((photo (picture "01ARZ3NDEKTSV4RRFFQ69G5FAC"))
           (tag (make "tag" (list "name" "Slow") :publish t))
           (ann (make "author" (list "name" "Ann" "favorite" (content-id tag)) :publish t))
           (story (make "story" (list "title" "Plain"
                                      "byline" (list :note "<p>Written <em>slowly</em> <img src=\"/media/site/x.png\"></p>" :caption "a <b and c> d" :kind "zebra" :photo photo :by (content-id ann)))
                        :publish t)))
      (let ((byline (access (delivered-data (deliver story (model "story") "site")) :byline)))
        (ok (media-p (access byline :photo)) "media inside is expanded")
        (ok (stringp (access byline :by)) "a reference inside stays an id"))
      (let ((byline (access (delivered-data (deliver story (model "story") "site" :include '(("byline" "by")))) :byline)))
        (ok (delivered-p (access byline :by)) "until a path names it")
        (ok (string= (access (delivered-data (access byline :by)) :name) "Ann")))
      (let ((byline (access (delivered-data (deliver story (model "story") "site" :include '(("byline" "by" "favorite")))) :byline)))
        (ok (delivered-p (access (delivered-data (access byline :by)) :favorite))
            "and a path that goes on past it embeds what that content refers to"))
      (let ((one (reads-of (lambda () (delivered-list "site" (model "story") (query "include" "byline.by"))))))
        (make "story" (list "title" "Second" "byline" (list :photo (picture "01ARZ3NDEKTSV4RRFFQ69G5F01") :by (content-id ann)))
              :publish t)
        (ok (equal (reads-of (lambda () (delivered-list "site" (model "story") (query "include" "byline.by")))) one)
            "a page reads what its custom fields hold together, however many contents it has")
        (ng (intersection one '("FIND-CONTENT" "FIND-MEDIA") :test #'string=) "and not one by one"))
      (ok (null (handler-case (progn (delivered-list "site" (model "story") (query "include" "byline.by")) nil)
                  (query-error (e) e)))
          "and the path is checked through the custom field")
      (ok (signals (delivered-list "site" (model "story") (query "include" "byline.note")) 'query-error))
      (flet ((found (&rest kv) (length (delivered-list "site" (model "story") (apply #'query kv)))))
        (ok (= (found "q" "slowly") 1) "q reads the text inside")
        (ok (= (found "q" "b and c") 1) "a text inside is matched as it is written, not as HTML")
        (ok (= (found "q" "zebra") 0) "only the text fields inside are searched")
        (ok (= (found "q" "d written") 0) "each one on its own")
        (ok (= (found "filters" "byline[contains]written slowly") 1) "and so does contains")
        (ok (signals (found "filters" "byline[equals]x") 'query-error) "but nothing else filters it")
        (ok (signals (found "orders" "byline") 'query-error) "or orders by it")))))

(defun with-blocks ()
  (make-schema :custom-fields (list (make-custom-field "byline" (list (make-field :by :reference :model "author")
                                                                      (make-field :photo :media)
                                                                      (make-field :text :text)))
                                    (make-custom-field "body" (list (make-field :text :richtext)
                                                                    (make-field :by :text)
                                                                    (make-field :kind :select :options '("zebra" "other")))))
               :models (list (make-model "story" :list (list (make-field :title :text)
                                                             (make-field :by :reference :model "author")
                                                             (make-field :blocks :repeater :custom-fields '(byline body))))
                             (make-model "author" :list (list (make-field :name :text))))))

(deftest a-repeater-is-delivered-row-by-row
  (with-schema ("site" (with-blocks))
    (let* ((photo (picture "01ARZ3NDEKTSV4RRFFQ69G5FAD"))
           (ann (make "author" (list "name" "Ann") :publish t))
           (story (make "story" (list "title" "Rows" "by" (content-id ann)
                                      "blocks" (vector (list :field-id "body" :text "<p>Written <em>slowly</em></p>" :kind "zebra" :by "Someone")
                                                       (list :field-id "byline" :photo photo :by (content-id ann))))
                        :publish t)))
      (let ((rows (access (delivered-data (deliver story (model "story") "site")) :blocks)))
        (ok (string= (access (aref rows 0) :field-id) "body") "each row names its custom field")
        (ok (media-p (access (aref rows 1) :photo)) "media in a row is expanded")
        (ok (stringp (access (aref rows 1) :by)) "a reference in a row stays an id"))
      (let ((rows (access (delivered-data (deliver story (model "story") "site" :include '(("blocks" "by")))) :blocks)))
        (ok (delivered-p (access (aref rows 1) :by)) "until a path names it")
        (ok (equal (access (aref rows 0) :by) "Someone")
            "and a field of that name in another custom field, which is no reference, is left as it is"))
      (let ((data (delivered-data (deliver story (model "story") "site" :include '(("blocks" "by"))))))
        (ok (stringp (access data :by)) "a reference of that name outside the rows stays an id"))
      (let ((data (delivered-data (deliver story (model "story") "site" :include '(("by"))))))
        (ok (delivered-p (access data :by)) "a path that names only it embeds it")
        (ok (stringp (access (aref (access data :blocks) 1) :by)) "and leaves the one in a row an id"))
      (ok (signals (delivered-list "site" (model "story") (query "include" "blocks.text")) 'query-error)
          "a path names a reference in the rows")
      (flet ((found (&rest kv) (length (delivered-list "site" (model "story") (apply #'query kv)))))
        (ok (= (found "q" "written slowly") 1) "q reads the text fields of the rows")
        (ok (= (found "q" "zebra") 0) "and only those")
        (ok (= (found "q" "em") 0) "a rich text field in a row is read as its text, whatever another custom field calls text")
        (ok (= (found "filters" "blocks[contains]slowly") 1) "and so does contains")
        (ok (= (found "filters" "blocks[not_contains]slowly") 0))
        (ok (signals (found "filters" "blocks[equals]x") 'query-error) "but nothing else filters it")
        (ok (signals (found "orders" "blocks") 'query-error) "or orders by it"))
      (let ((one (reads-of (lambda () (delivered-list "site" (model "story") (query "include" "blocks.by"))))))
        (make "story" (list "title" "Second"
                            "blocks" (vector (list :field-id "byline" :photo (picture "01ARZ3NDEKTSV4RRFFQ69G5F02") :by (content-id ann))))
              :publish t)
        (ok (equal (reads-of (lambda () (delivered-list "site" (model "story") (query "include" "blocks.by")))) one)
            "a page reads what its rows hold together, however many contents it has")
        (ng (intersection one '("FIND-CONTENT" "FIND-MEDIA") :test #'string=) "and not one by one")))))

(deftest several-media-in-one-field
  (with-schema ("site" (make-schema :models (list (make-model "album" :list (list (make-field :title :text)
                                                                                  (make-field :photos :media :many t))))))
    (let* ((a (picture "01ARZ3NDEKTSV4RRFFQ69G5FAE"))
           (b (picture "01ARZ3NDEKTSV4RRFFQ69G5FAF"))
           (album (make "album" (list "title" "A" "photos" (vector b "01ARZ3NDEKTSV4RRFFQ69G5GON" a)) :publish t))
           (photos (access (delivered-data (deliver album (model "album") "site")) :photos)))
      (ok (= (length photos) 2) "a file that is gone drops out")
      (ok (and (media-p (aref photos 0)) (string= (media-id (aref photos 0)) b)) "the rest are media, in their order")
      (ok (string= (media-id (aref photos 1)) a)))))

(defun make-post (n)
  (let* ((favorite (make "tag" (list "name" (format nil "fav~a" n)) :publish t))
         (author (make "author" (list "name" (format nil "a~a" n)
                                      "avatar" (picture (format nil "01ARZ3NDEKTSV4RRFFQ69G5A~2,'0d" n))
                                      "favorite" (content-id favorite))
                       :publish t))
         (tags (loop :for i :below 3 :collect (content-id (make "tag" (list "name" (format nil "t~a-~a" n i)) :publish t)))))
    (make "post" (list "title" (format nil "p~a" n)
                       "cover" (picture (format nil "01ARZ3NDEKTSV4RRFFQ69G5C~2,'0d" n))
                       "author" (content-id author)
                       "tags" (coerce tags 'vector))
          :publish t)))

(deftest what-a-page-refers-to-is-read-once-per-field
  (let ((query (query "include" "author.favorite,tags")))
    (make-post 0)
    (let ((one (reads-of (lambda () (delivered-list "site" (model "post") query)))))
      (ng (member "FIND-CONTENT" one :test #'string=) "no reference is read on its own")
      (ng (member "FIND-MEDIA" one :test #'string=) "nor a media")
      (ok (equal one '("(FIND-CONTENTS-BY-IDS author)" "(FIND-CONTENTS-BY-IDS tag)" "(FIND-CONTENTS-BY-IDS tag)"
                       "FIND-MEDIA-BY-IDS" "FIND-MEDIA-BY-IDS"))
          "each field's targets are read once: the authors, their favorites, the tags, the covers and the avatars")
      (loop :for n :from 1 :to 4 :do (make-post n))
      (let ((five (reads-of (lambda () (delivered-list "site" (model "post") query)))))
        (ok (= (length (delivered-list "site" (model "post") query)) 5))
        (ok (equal five one) "five contents are read with as many reads as one")))
    (let ((post (first (delivered-list "site" (model "post") query))))
      (ok (media-p (access (delivered-data post) :cover)) "and each one still gets its media")
      (ok (= (length (access (delivered-data post) :tags)) 3) "its references")
      (ok (delivered-p (access (delivered-data (access (delivered-data post) :author)) :favorite))
          "and what they refer to in turn"))
    (let ((post (make-post 9)))
      (ok (equal (reads-of (lambda () (deliver post (model "post") "site" :include '(("tags")))))
                 '("(FIND-CONTENTS-BY-IDS tag)" "FIND-MEDIA-BY-IDS"))
          "and one content on its own reads its tags together too"))))

(deftest a-page-embeds-each-content-s-own-references
  (let ((one (content-id (make "tag" (list "name" "one") :publish t)))
        (two (content-id (make "tag" (list "name" "two") :publish t)))
        (unseen (content-id (make "tag" (list "name" "unseen"))))
        (ann (content-id (make "author" (list "name" "Ann") :publish t)))
        (bob (content-id (make "author" (list "name" "Bob")))))
    (make "post" (list "title" "a" "author" ann "tags" (vector two one two "gone" unseen)) :publish t)
    (make "post" (list "title" "b" "author" bob "tags" (vector one)) :publish t)
    (make "post" (list "title" "c" "author" "gone") :publish t)
    (let ((posts (make-hash-table :test 'equal)))
      (dolist (post (delivered-list "site" (model "post") (query "include" "author,tags")))
        (setf (gethash (access (delivered-data post) :title) posts) (delivered-data post)))
      (flet ((names (title)
               (map 'list (lambda (tag) (access (delivered-data tag) :name)) (access (gethash title posts) :tags)))
             (author (title) (access (gethash title posts) :author)))
        (ok (equal (names "a") '("two" "one" "two"))
            "in the order they are stored, each as often as it is stored, without what is gone or unpublished")
        (ok (equal (names "b") '("one")) "and a tag another content refers to too comes to each")
        (ok (string= (access (delivered-data (author "a")) :name) "Ann"))
        (ok (eq :null (author "b")) "an unpublished one is null for its content only")
        (ok (eq :null (author "c")) "and so is one that does not exist")))))

(deftest a-page-gives-each-content-its-own-media
  (let ((first-cover (picture "01ARZ3NDEKTSV4RRFFQ69G5E01"))
        (second-cover (picture "01ARZ3NDEKTSV4RRFFQ69G5E02")))
    (make "post" (list "title" "a" "cover" first-cover) :publish t)
    (make "post" (list "title" "b" "cover" second-cover) :publish t)
    (make "post" (list "title" "c" "cover" "01ARZ3NDEKTSV4RRFFQ69G5E03") :publish t)
    (make "post" (list "title" "d" "cover" first-cover) :publish t)
    (let ((covers (make-hash-table :test 'equal)))
      (dolist (post (delivered-list "site" (model "post") (query)))
        (setf (gethash (access (delivered-data post) :title) covers) (access (delivered-data post) :cover)))
      (ok (string= (media-id (access covers :a)) first-cover))
      (ok (string= (media-id (access covers :b)) second-cover) "each content its own")
      (ok (eq :null (access covers :c)) "a media that is gone is null for its content only")
      (ok (string= (media-id (access covers :d)) first-cover) "and one media two contents hold comes to both"))))

(deftest what-is-not-there-is-not-read
  (make "post" (list "title" "a" "cover" "" "author" "" "tags" (vector)) :publish t)
  (let ((reads (reads-of (lambda () (delivered-list "site" (model "post") (query "include" "author,tags"))))))
    (ok (null reads) "a blank media, a blank reference and no tags, so nothing is read for them"))
  (exec "UPDATE contents SET published = json_set(published, '$.tags', json_array('')) WHERE model = 'post'")
  (ok (null (reads-of (lambda () (delivered-list "site" (model "post") (query "include" "author,tags")))))
      "nor for a list that names only a blank, as data written to the database by hand")
  (testing "nor what a field cannot hold, as data written to the database by hand"
    (let ((tag (content-id (make "tag" (list "name" "one") :publish t))))
      (exec "UPDATE contents SET published = json_set(published, '$.tags', ?) WHERE model = 'post'" tag)
      (let ((reads (reads-of (lambda () (delivered-list "site" (model "post") (query "include" "tags"))))))
        (ok (null reads))
        (ok (data-equal (access (delivered-data (first (delivered-list "site" (model "post") (query "include" "tags")))) :tags)
                        #())
            "and the field is delivered as before, empty"))
      (exec "UPDATE contents SET published = json_set(published, '$.tags', 5, '$.author', json_array(?), '$.cover', json_array(?)) WHERE model = 'post'"
            tag (picture "01ARZ3NDEKTSV4RRFFQ69G5E04"))
      (let ((reads (reads-of (lambda () (delivered-list "site" (model "post") (query "include" "author,tags"))))))
        (ok (null reads) "a list in a field that holds one is not read either")
        (let ((data (delivered-data (first (delivered-list "site" (model "post") (query "include" "author,tags"))))))
          (ok (data-equal (access data :tags) #()) "a field that holds a list and has something else is empty")
          (ok (eq :null (access data :author)) "a reference that holds one and has a list is null")
          (ok (eq :null (access data :cover)) "and so is a media"))))))
