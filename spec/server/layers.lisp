(defpackage #:koya-spec/server/layers
  (:use #:cl #:rove)
  (:import-from #:okite #:define-layers #:layer-violations))
(in-package #:koya-spec/server/layers)

(define-layers koya-server
  (:layers (:log             "log")
           (:domain          "domain/")
           (:presenter-ports "usecases/ports/presenters")
           (:ports           "usecases/ports/")
           (:usecases        "usecases/")
           (:infra           "infra/")
           (:web             "web/")
           (:ui              "web/ui/")
           (:pages           "web/pages/")
           (:api             "web/api/")
           (:admin-api       "web/admin-api/")
           (:main            "main"))
  (:allow (:domain          :log)
          (:ports           :log :domain :presenter-ports)
          (:presenter-ports :log :domain)
          (:usecases        :log :domain :ports :presenter-ports)
          (:infra           :log :domain :ports)
          (:web             :log :domain :usecases :presenter-ports)
          (:ui              :log :domain :usecases :web)
          (:pages           :log :domain :usecases :web :ui)
          (:api             :log :domain :usecases :web)
          (:admin-api       :log :domain :usecases :web)
          (:main            :log :domain :ports :presenter-ports :usecases :infra :web))
  (:isolated :pages :api :admin-api)
  (:libraries ("cl-dbi" :infra) ("zippy" :infra) ("dexador" :infra) ("usocket" :infra) ("cl-dotenv" :infra)
              ("clack" :main) ("lack" :web) ("lack-middleware-session" :infra) ("lack-mw" :web)
              ("jingle" :web :ui :pages :admin-api)
              ("ningle-actions" :web :ui :pages) ("ningle-fbr" :web) ("smart-buffer" :web)
              ("hsx" :web :ui :pages) ("okite" :main) ("piping" :main) ("verbose" :log :main)
              ("koya-core/json" :web :ui :pages :api :admin-api :infra)
              ("koya-core/case" :web :ui :pages :api :admin-api :infra)
              ("koya-core/schema-json" :web :ui :pages :api :admin-api :infra))
  (:anywhere "koya-core/schema" "koya-core/validate" "koya-core/data" "koya-core/diff" "koya-core/time"
             "koya-core/ulid" "access" "alexandria" "cl-ppcre" "babel" "ironclad" "local-time"
             "bordeaux-threads" "quri")
  (:forbid "koya-sdk" "ningle"))

(deftest layers
  (let ((violations (layer-violations 'koya-server)))
    (ok (null violations) (format nil "~{~a~^~%~}" violations))))
