(defpackage #:koya-spec/core/validate
  (:use #:cl #:rove)
  (:import-from #:koya-core/schema
                #:make-field #:make-model #:make-schema #:make-custom-field #:schema-model)
  (:import-from #:koya-core/validate
                #:validate-content #:fitted-shape)
  (:import-from #:koya-core/data
                #:data-equal))
(in-package #:koya-spec/core/validate)

(defparameter *model*
  (make-model "blog" :list
              (list (make-field :title :text :required t :max-length 10 :pattern "^[A-Z]")
                    (make-field :slug :slug)
                    (make-field :body :richtext)
                    (make-field :count :number :integer t :min 0 :max 10)
                    (make-field :featured :boolean)
                    (make-field :day :date)
                    (make-field :event-at :datetime :required t)
                    (make-field :category :select :options (quote ("news" "tech")))
                    (make-field :labels :select :options (quote ("a" "b")) :many t)
                    (make-field :tags :reference :model "tag" :many t)
                    (make-field :cover :media))))

(defun codes (data)
  (mapcar (lambda (e) (cons (getf e :field) (getf e :code)))
          (validate-content *model* data)))

(deftest valid-content
  (ok (null (codes (list :title "Hello" :event-at "2026-09-20T00:00:00Z" :slug "hello-world"
                         :count 3 :featured t :day "2026-09-20" :category "news"
                         :labels (vector "a" "b") :tags (vector "01ARZ3NDEKTSV4RRFFQ69G5FAV")
                         :cover "01ARZ3NDEKTSV4RRFFQ69G5FAV" :body "# hi"))))
  (ok (null (codes (list :title "Hello" :event-at "2026-09-20T00:00:00Z" :featured nil)))
      "false boolean is fine"))

(deftest required
  (ok (equal (codes nil) '(("title" . "required") ("eventAt" . "required"))))
  (ok (equal (codes (list :title "  " :event-at :null))
             '(("title" . "required") ("eventAt" . "required")))
      "blank and null count as missing")
  (let ((model (make-model "note" :list (list (make-field :body :richtext :required t)))))
    (ok (null (validate-content model (list :body "<p><br></p>")))
        "rich text is blank as any string is: markup is a value")
    (ok (equal (mapcar (lambda (e) (getf e :code))
                       (validate-content model (list :body (format nil " ~% "))))
               '("required")))
    (ok (null (validate-content model (list :body "<p>a</p>")))))
  (testing "partial skips missing fields"
    (ok (null (validate-content *model* nil :partial t)))
    (ok (equal (mapcar (lambda (e) (getf e :code))
                       (validate-content *model* (list :title :null) :partial t))
               '("required")))))

(deftest false-and-empty-array-are-values
  (ok (equal (codes (list :title nil :event-at "2026-09-20T00:00:00Z" :count nil))
             '(("title" . "type") ("count" . "type")))
      "false is only a boolean")
  (ok (equal (codes (list :title (vector) :event-at "2026-09-20T00:00:00Z"))
             '(("title" . "type")))
      "[] on a single-value field")
  (ok (null (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :labels (vector) :tags (vector))))
      "[] on a many field is blank"))

(deftest type-errors
  (ok (equal (codes (list :title 1 :event-at "nope"))
             '(("title" . "type") ("eventAt" . "type"))))
  (ok (null (codes (list :title "Ok" :event-at "2026-09-20T19:00+09:00")))
      "a datetime may leave out its seconds, in any zone")
  (ok (null (codes (list :title "Ok" :event-at "2026-09-20T10:00Z"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T10:00"))
             '(("eventAt" . "type")))
      "but not its zone")
  (ok (equal (codes (list :title "Toolongtitle!" :event-at "2026-09-20T00:00:00Z"))
             '(("title" . "max_length"))))
  (ok (equal (codes (list :title "lower" :event-at "2026-09-20T00:00:00Z"))
             '(("title" . "pattern"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :slug "Not Slug"))
             '(("slug" . "slug"))))
  (ok (member '("slug" . "type") (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :slug 42)) :test #'equal)
      "a slug must be a string")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :count 2.5))
             '(("count" . "integer"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :count 11))
             '(("count" . "max"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :featured "yes"))
             '(("featured" . "type"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :day "2026-9-20"))
             '(("day" . "type"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-02-30T00:00:00Z" :day "2026-02-30"))
             '(("day" . "type") ("eventAt" . "type")))
      "calendar-invalid dates are type errors, not crashes")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20"))
             '(("eventAt" . "type")))
      "a datetime needs a time and a zone")
  (ok (null (codes (list :title "Ok" :event-at "2026-09-20T09:00:00+09:00"))) "offsets are fine")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :category "sports"))
             '(("category" . "option"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :labels "a"))
             '(("labels" . "type")))
      "many requires an array")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :cover (format nil "abc~%")
                          :slug (format nil "ok~%") :day (format nil "2026-09-20~%")))
             '(("slug" . "slug") ("day" . "type") ("cover" . "type")))
      "a trailing newline is not accepted by anchored patterns")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :tags (vector "bad id!")))
             '(("tags" . "type"))))
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :extra 1))
             '(("extra" . "unknown_field"))))
  (ok (equal (codes (list :title "Ok" "event-at" "2026-09-20T00:00:00Z"))
             '(("event-at" . "unknown_field") ("eventAt" . "required")))
      "a key spelled as a field's keyword is not that field")
  (ok (equal (codes (list :title "Ok" :event-at "2026-09-20T00:00:00Z" :name 1))
             '(("name" . "unknown_field")))
      "nor is one whose keyword exists for another reason"))

(defparameter *with-seo*
  (schema-model
   (make-schema :custom-fields (list (make-custom-field "seo" (list (make-field :title :text :required t :max-length 5)
                                                                    (make-field :image :media)
                                                                    (make-field :indexed :boolean :required t))))
                :models (list (make-model "page" :list (list (make-field :meta :custom :custom-field "seo")))
                              (make-model "post" :list (list (make-field :meta :custom :custom-field "seo" :required t)))))
   "page"))

(defun seo-codes (data &optional (model *with-seo*))
  (mapcar (lambda (e) (cons (getf e :field) (getf e :code)))
          (validate-content model data)))

(deftest a-custom-field-is-an-object-of-its-fields
  (ok (null (seo-codes (list :meta (list :title "Hi" :image "01ARZ3NDEKTSV4RRFFQ69G5FAV")))))
  (ok (null (seo-codes nil)) "an optional one may be absent")
  (ok (equal (seo-codes (list :meta "Hi")) '(("meta" . "type"))) "it must be an object")
  (ok (equal (seo-codes (list :meta (list :title "Too long" :image 3)))
             '(("meta.title" . "max_length") ("meta.image" . "type")))
      "each field inside is checked, and named by its path")
  (ok (equal (seo-codes (list :meta (list :image "01ARZ3NDEKTSV4RRFFQ69G5FAV"))) '(("meta.title" . "required")))
      "a required field inside is required once the object is there; a boolean never is")
  (ok (equal (seo-codes (list :meta (list :title "Hi" :extra 1))) '(("meta.extra" . "unknown_field"))))
  (ok (equal (seo-codes (list :meta (list :title nil))) '(("meta.title" . "type")))
      "false is no value only for a boolean")
  (ok (equal (seo-codes (list :meta (list :bogus :null))) '(("meta.bogus" . "unknown_field") ("meta.title" . "required")))
      "and a key the custom field does not have is never blank")
  (ok (equal (seo-codes (list :meta (list :indexed t))) '(("meta.title" . "required")))
      "an object given is a value, whatever it holds")
  (ok (equal (seo-codes (list :meta nil)) '(("meta.title" . "required"))) "even an empty one")
  (ok (null (seo-codes (list :meta :null))) "and null is none")
  (let ((post (schema-model (make-schema :custom-fields (list (make-custom-field "seo" (list (make-field :title :text))))
                                         :models (list (make-model "post" :list (list (make-field :meta :custom :custom-field "seo" :required t)))))
                            "post")))
    (ok (equal (seo-codes nil post) '(("meta" . "required"))))
    (ok (equal (seo-codes (list :meta :null) post) '(("meta" . "required"))))
    (ok (null (seo-codes (list :meta (list :title " ")) post)) "an object whose fields are blank is still one")))

(defparameter *with-blocks*
  (make-schema :custom-fields (list (make-custom-field "heading" (list (make-field :text :text :required t :max-length 5)))
                                    (make-custom-field "image" (list (make-field :photo :media)
                                                                     (make-field :wide :boolean))))
               :models (list (make-model "page" :list (list (make-field :blocks :repeater :custom-fields '(heading image))))
                             (make-model "post" :list (list (make-field :blocks :repeater :custom-fields '(heading) :required t))))))

(defun block-codes (model data)
  (mapcar (lambda (e) (cons (getf e :field) (getf e :code)))
          (validate-content (schema-model *with-blocks* model) data)))

(deftest a-repeater-is-a-list-of-rows
  (ok (null (block-codes "page" (list :blocks (vector (list :field-id "heading" :text "Hi")
                                                      (list :field-id "image" :photo "01ARZ3NDEKTSV4RRFFQ69G5FAV" :wide t))))))
  (ok (null (block-codes "page" (list :blocks (vector)))) "no rows is no value")
  (ok (equal (block-codes "post" (list :blocks (vector))) '(("blocks" . "required"))) "and a required one wants a row")
  (ok (equal (block-codes "page" (list :blocks nil)) '(("blocks" . "type"))) "it must be an array")
  (ok (equal (block-codes "page" (list :blocks (vector "Hi"))) '(("blocks[0]" . "type"))) "of objects")
  (ok (equal (block-codes "page" (list :blocks (vector (list :text "Hi") (list :field-id "quote"))))
             '(("blocks[0]" . "custom_field") ("blocks[1]" . "custom_field")))
      "each naming one of the repeater's custom fields")
  (ok (equal (block-codes "page" (list :blocks (vector (list :field-id "image") (list :field-id "heading" :text "Too long" :photo "x"))))
             '(("blocks[1].photo" . "unknown_field") ("blocks[1].text" . "max_length")))
      "and checked as that custom field, by its path")
  (ok (equal (block-codes "page" (list :blocks (vector (list :field-id "heading")))) '(("blocks[0].text" . "required")))))

(deftest a-media-field-can-hold-several
  (let ((model (make-model "album" :list (list (make-field :photos :media :many t :required t)))))
    (flet ((codes (data) (mapcar (lambda (e) (cons (getf e :field) (getf e :code))) (validate-content model data))))
      (ok (null (codes (list :photos (vector "01ARZ3NDEKTSV4RRFFQ69G5FAV" "01ARZ3NDEKTSV4RRFFQ69G5FAW")))))
      (ok (equal (codes (list :photos "01ARZ3NDEKTSV4RRFFQ69G5FAV")) '(("photos" . "type"))) "an array of ids")
      (ok (equal (codes (list :photos (vector "no id"))) '(("photos" . "type"))))
      (ok (equal (codes (list :photos (vector))) '(("photos" . "required"))) "and none is no value"))))

(defun fits (model data fitted)
  (data-equal (fitted-shape model data) fitted))

(deftest a-fitted-shape-keeps-what-fits-its-fields-types
  (ok (fits *model*
            (list :title "lowercase and far too long" :count 12.5 :category "sports" :labels "a"
                  :cover (vector "01ARZ3NDEKTSV4RRFFQ69G5FAV"))
            (list :title "lowercase and far too long" :count 12.5 :category "sports" :labels "a"
                  :cover (vector "01ARZ3NDEKTSV4RRFFQ69G5FAV")))
      "a value is kept whatever its field's options say, and one that may be many may be one or several")
  (ok (fits *model* (list :title (vector "One") :body 3 :category 1 :slug "Not Slug" :day :null :extra 1) nil)
      "a value not of its field's type goes, as do several in a field that holds one, a null and a key that is not a field")
  (ok (fits *model* (list :tags (vector "bad id!" "01ARZ3NDEKTSV4RRFFQ69G5FAV"))
            (list :tags (vector "01ARZ3NDEKTSV4RRFFQ69G5FAV")))
      "of several, only those not of the type go")
  (ok (fits *with-seo* (list :meta (list :title "Too long" :image 3 :extra 1))
            (list :meta (list :title "Too long")))
      "a custom field's own fields are fitted the same way")
  (ok (fits *with-seo* (list :meta "Hi") nil))
  (ok (fits (schema-model *with-blocks* "page")
            (list :blocks (vector (list :field-id "quote") "Hi"
                                  (list :field-id "image" :wide "yes" :photo "01ARZ3NDEKTSV4RRFFQ69G5FAV")
                                  (list :field-id "heading" :text "Too long")))
            (list :blocks (vector (list :photo "01ARZ3NDEKTSV4RRFFQ69G5FAV" :field-id "image")
                                  (list :text "Too long" :field-id "heading"))))
      "a row of a custom field its repeater does not list goes, and the others are fitted")
  (ok (fits (schema-model *with-blocks* "page") (list :blocks "flat") nil)))
