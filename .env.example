KOYA_ENV=dev
KOYA_SECRET=change-me
# optional second factor for the admin login: (koya-server:totp-setup) prints a value
#KOYA_TOTP_SECRET=
KOYA_DB_PATH=./data/koya.db
KOYA_MEDIA_DIR=./data/media
# port to listen on, and the public URL (must match the port when served directly)
KOYA_PORT=3100
KOYA_BASE_URL=http://localhost:3100
